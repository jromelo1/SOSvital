<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SOSvital" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorPrimaryVariant">@color/red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_warn</item>
        <item name="android:statusBarColor">@color/red_dark</item>
    </style>

    <!-- Full-screen alert — no action bar -->
    <style name="Theme.SOSvital.Alert" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/red_primary</item>
        <item name="android:statusBarColor">@color/red_dark</item>
        <item name="android:navigationBarColor">@color/red_dark</item>
    </style>
</resources>
